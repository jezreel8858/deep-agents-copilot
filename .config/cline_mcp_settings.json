{
  "mcpServers": {
    "codegraph": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "codegraph",
        "mcp",
        "--multi-repo"
      ],
      "env": {},
      "transportType": "stdio",
      "disabled": false,
      "timeout": 300
    },
    "tavily": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "env": {
        "TAVILY_API_KEY": "",
        "PATH": "C:\\Program Files\\nodejs;%PATH%",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "transportType": "stdio",
      "disabled": false,
      "timeout": 300
    },
    "context-mode": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "context-mode",
        "server",
        "--agent",
        "copilot-cli"
      ],
      "env": {
        "JAVA_HOME": "C:\\Program Files\\Java\\jdk-22",
        "CONTEXT_MODE_DATA_DIR": "D:\\workspace\\public\\deep-agents-copilot\\.claude\\context-mode\\sessions",
        "PATH": "C:\\Program Files\\nodejs;%PATH%"
      },
      "transportType": "stdio",
      "timeout": 600,
      "disabled": false
    }
  }
}
