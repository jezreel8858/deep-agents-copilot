{
  "servers": {
    "codegraph": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "codegraph",
        "mcp",
        "--multi-repo"
      ],
      "env": {},
      "disabled": false
    },
    "tavily": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "tavily-mcp@latest"
      ],
      "env": {
        "TAVILY_API_KEY": "",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "disabled": false
    },
    "context-mode": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "context-mode",
        "server",
        "--agent",
        "copilot-cli"
      ],
      "env": {
        "JAVA_HOME": "C:\\Program Files\\Java\\jdk-22",
        "CONTEXT_MODE_DATA_DIR": "C:\\Users\\{username}\\.config\\JetBrains\\context-mode"
      },
      "timeout": 600000,
      "disabled": false
    },
    "playwright": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--storage-state=playwright/.auth/user.json",
        "--output-dir=.playwright-mcp"
      ],
      "env": {},
      "disabled": false
    },
    "mcp-atlassian": {
      "command": "uvx",
      "args": [
        "-q",
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://your-company.atlassian.net",
        "JIRA_USERNAME": "your.email@company.com",
        "JIRA_API_TOKEN": "your_api_token",
        "CONFLUENCE_URL": "https://your-company.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "your.email@company.com",
        "CONFLUENCE_API_TOKEN": "your_api_token"
      }
    },
    "figma": {
      "command": "uvx",
      "args": [
        "-q",
        "--offline",
        "--with",
        "mcp==1.30.0",
        "mcp-figma==0.0.2"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "SEU_TOKEN_AQUI",
        "SSL_CERT_FILE": "SEU_PATH_CERTIFICADO_PEM"
      }
    }
  }
}
