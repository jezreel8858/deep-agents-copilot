# ==============================================================================
# Deep Agents Gateway - Configuracao de Ambiente (sem dado real)
# Copie para .env e preencha valores locais. Ver BLUEPRINT_LOCAL_CHAT_GATEWAY.md Secao 3.2
# ==============================================================================

# Docker secret (preferido a env var); gitignored
COPILOT_SDK_TOKEN_FILE=./secrets/copilot_token

# Bearer UI<->gateway; RECUSA subir se valor for "change-me"
GATEWAY_API_KEY=change-me

# Codigo de acesso da UI web (apps/web, CopilotKit); RECUSA subir se "change-me"
WEB_ACCESS_CODE=change-me

# Porta publicada da UI web (127.0.0.1-only)
WEB_PORT=3000

# Exposicao de rede
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080

# Diretorio-pai comum (path absoluto do HOST) contendo TODOS os projetos
# registrados em projects.local.yaml (`path_externo`), montado uma unica
# vez em /workspaces dentro do container. Descoberta automatica via
# `projects_catalog.py`: qualquer projeto novo adicionado ao YAML, clonado
# sob este mesmo diretorio-pai, fica acessivel ao Copilot SEM editar
# .env/docker-compose.yml. Vazio = nenhum projeto traduzivel (o compose usa
# o fallback ./.workspace-placeholder, seguro em read_only mas insuficiente
# para propose/apply).
PROJECTS_ROOT_PATH=

# Traducao de root_path (R-043) -- caminho DENTRO do container (o
# repositorio de governanca inteiro ja e montado em /governance:ro).
PROJECTS_LOCAL_YAML=/governance/.github/projects.local.yaml

# read_only | propose | apply
GATEWAY_PERMISSION_MODE=read_only

# Por sessao (reusa budget.py)
GOV_MAX_PREMIUM_REQUESTS=15

# Teto diario local
GATEWAY_MAX_PREMIUM_PER_DAY=100

# Timeouts
GATEWAY_REQUEST_TIMEOUT_S=300
GATEWAY_SESSION_TTL_S=1800

# vazio = desligado; ex: http://otel-collector:4318 ou http://host.docker.internal:4318
#
# ATENCAO (bug real de producao, 2026-10-01): NAO use o nome "OTEL_EXPORTER_
# OTLP_ENDPOINT" aqui. O proxy OTel standalone do HOST usado para telemetria
# da IDE (tools/otel-langfuse/, ver docs/context/setup-telemetry-copilot.md)
# convenciona exportar essa mesma variavel no shell/perfil do desenvolvedor
# apontando para "http://127.0.0.1:4318". Docker Compose da precedencia a
# variaveis de SHELL sobre o ".env" -- se este arquivo usasse o mesmo nome,
# o container do gateway herdaria silenciosamente "127.0.0.1:4318" (loopback
# DELE MESMO, onde nada escuta) em vez do coletor real, quebrando toda a
# telemetria do gateway sem nenhum erro visivel. "GATEWAY_OTEL_EXPORTER_
# OTLP_ENDPOINT" e exclusivo deste compose.
GATEWAY_OTEL_EXPORTER_OTLP_ENDPOINT=

# Credencial Basic Auth (Base64 de public_key:secret_key) para envio ao Langfuse Cloud
# (necessario ao rodar com o coletor via --profile otel)
LANGFUSE_OTLP_AUTH=

# Endpoint do Langfuse (padrao EU: https://cloud.langfuse.com/api/public/otel | US: https://us.cloud.langfuse.com/api/public/otel)
LANGFUSE_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# Modelo de LLM subjacente (vazio = padrao do SDK)
COPILOT_MODEL=

# Grafo de roteamento/governanca (Q-01..Q-05 -- Fase 5). OBRIGATORIO: o
# lifespan do gateway falha explicitamente no startup (fail-fast, Q-02) se
# este caminho nao apontar para um grafo valido. O default abaixo ja
# corresponde ao caminho DENTRO do container (o repositorio de governanca
# inteiro e montado read-only em /governance -- ver docker-compose.yml);
# normalmente nao precisa ser alterado.
GOVERNANCE_GRAPH_PATH=/governance/.github/agents/routing-graph.yaml

# Vazio = usa o schema JSON padrao embutido no pacote governance_runner.routing (Q-03).
GOVERNANCE_SCHEMA_PATH=

# Raiz de .github/ para persona/nucleo injetados no system_message do SDK
# (Addendum 5, bug real 2026-10-01): default ja aponta para o caminho DENTRO
# do container (volume read-only /governance -- ver docker-compose.yml);
# normalmente nao precisa ser alterado.
GOVERNANCE_GITHUB_DIR=/governance/.github

# Logging em arquivo (Fix 3, 2026-10-04) -- aditivo ao stdout do uvicorn,
# nunca o substitui (ver logging_config.py). Caminho relativo ao diretorio
# de trabalho do gateway (./.tmp/gateway.log por padrao, gitignored).
GATEWAY_LOG_FILE=.tmp/gateway.log

# Tamanho maximo (bytes) de cada arquivo de log antes de rotacionar (default: 5 MiB).
GATEWAY_LOG_MAX_BYTES=5242880

# Quantidade de arquivos de backup rotacionados mantidos.
GATEWAY_LOG_BACKUP_COUNT=3

# ==============================================================================
# MCP Servers (RC2, bugfix 2026-10-02/2026-10-04) -- lista FECHADA:
# context-mode, tavily, codegraph. Nenhum outro servidor e registrado,
# independentemente de configuracao externa (ver mcp_servers_catalog.py).
# Defaults abaixo confirmados contra `.vscode/mcp.json` (configuracao REAL
# e ja funcional da propria IDE para estes mesmos servidores) -- NUNCA usar
# nomes de pacote com escopo "@context-mode/mcp-server" ou
# "@codegraph/mcp-server" (ambos 404 inexistentes no registry do npm).
# No Windows, o gateway envolve automaticamente com `cmd.exe /c` (scripts
# .cmd do npm nao sao executaveis nativos); em Linux/Docker, roda direto.
# ==============================================================================

MCP_CONTEXT_MODE_ENABLED=true
MCP_CONTEXT_MODE_COMMAND=npx
MCP_CONTEXT_MODE_ARGS=-y,context-mode

MCP_TAVILY_ENABLED=true
# Credencial real da API Tavily (https://tavily.com) -- fail-closed: sem
# valor preenchido, o servidor Tavily simplesmente nao e materializado.
TAVILY_API_KEY=

MCP_CODEGRAPH_ENABLED=true
# "codegraph" e um binario CLI instalado diretamente (nao via npx).
MCP_CODEGRAPH_COMMAND=codegraph
MCP_CODEGRAPH_ARGS=mcp,--multi-repo

