# Ambiente apps/web (sem dado real) — copie para .env.local em desenvolvimento.
# Em producao (docker-compose), estas variaveis vem do .env do gateway
# (deploy/local-chat-gateway/.env.example) via docker-compose.yml.

GATEWAY_BASE_URL=http://127.0.0.1:8080
GATEWAY_API_KEY=develop
GATEWAY_MODEL=deep-agents/router
WEB_ACCESS_CODE=develop

COPILOTKIT_TELEMETRY_DISABLED=true
NEXT_TELEMETRY_DISABLED=1

