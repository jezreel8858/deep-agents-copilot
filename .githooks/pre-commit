#!/usr/bin/env bash
# .githooks/pre-commit — Defesa em profundidade para R-043 (Local Overlay Pattern)
# e R-044 (Anonimização Obrigatória de Evidência de Análise Real)
#
# Bloqueia commits que vazem dados LOCAIS/PRIVADOS de projetos (R-043) ou
# evidência real de análise (nomes de repo/caminhos absolutos, R-044) para o
# repositório de governança compartilhado. Complementa (não substitui) o
# `.gitignore`/revisão manual — protege contra `git add -f` e edições
# acidentais.
#
# SETUP (uma vez por clone):
#   git config core.hooksPath .githooks
#
# Ver: CLAUDE.md § R-043, § R-044

set -euo pipefail

blocked=0

# 1) Nenhuma entrada de projeto pode ser adicionada a catálogos compartilhados.
#    Marcador de fingerprint: "path_externo:" só existe em entradas de projeto.
if git -c core.quotepath=off diff --cached --name-only | grep -E '^(.github/agents/catalog.yaml|docs/ai-context/catalog.yaml)$' >/dev/null 2>&1; then
  if git diff --cached -- .github/agents/catalog.yaml docs/ai-context/catalog.yaml 2>/dev/null | grep -E '^\+.*path_externo:' >/dev/null 2>&1; then
    echo "❌ [R-043] Bloqueado: catálogo compartilhado não pode conter entrada de projeto (path_externo:)."
    echo "   → Projetos vivem em .github/projects.local.yaml (gitignored)."
    blocked=1
  fi
fi

# 2) Nenhum arquivo sob .github/instructions/local/ pode ser commitado
#    (adapters gerados por-projeto — sempre locais/gitignored).
if git -c core.quotepath=off diff --cached --name-only | grep -E '^\.github/instructions/local/' >/dev/null 2>&1; then
  echo "❌ [R-043] Bloqueado: arquivo(s) staged sob .github/instructions/local/ (adapters locais, nunca commitados)."
  echo "   → Remova do stage: git restore --staged .github/instructions/local/*"
  blocked=1
fi

# 3) projects.local.yaml (instância real, não o .example) nunca pode ser commitado.
if git -c core.quotepath=off diff --cached --name-only | grep -E '^(\.github/projects\.local\.yaml|docs/ai-context/catalog\.local\.yaml)$' >/dev/null 2>&1; then
  echo "❌ [R-043] Bloqueado: .github/projects.local.yaml (overlay local real) nunca deve ser commitado."
  echo "   → Remova do stage: git restore --staged .github/projects.local.yaml"
  blocked=1
fi

# 4) Defesa em profundidade para R-044 (Anonimização Obrigatória de Evidência
#    de Análise Real): nenhum caminho de sistema de arquivos local ABSOLUTO
#    pode aparecer em conteúdo ADICIONADO sob .github/** (exceto local/, já
#    bloqueado acima) — sinal forte de vazamento de nome real de
#    repositório/usuário via changelog/exemplo de agent analítico.
#    CLAUDE.md/copilot-instructions.md são EXCLUÍDOS deste check: são os
#    próprios arquivos de definição da regra R-044 e legitimamente contêm
#    exemplos ilustrativos de caminho (ex.: "C:\\Users\\...", "D:\\workspace\\...")
#    para explicar o que NÃO fazer — não são evidência real de projeto.
staged_gov_files=$(git -c core.quotepath=off diff --cached --name-only | grep '^\.github/' | grep -v '^\.github/instructions/local/' || true)
if [ -n "$staged_gov_files" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if git diff --cached -- "$f" | grep -E '^\+.*([A-Za-z]:\\(Users|workspace)|/home/[A-Za-z0-9_.-]+/|/Users/[A-Za-z0-9_.-]+/)' >/dev/null 2>&1; then
      echo "❌ [R-044] Bloqueado: $f contém caminho de sistema de arquivos local absoluto (possível vazamento de evidência de projeto real)."
      echo "   → Genericize caminhos/nomes antes de commitar. Ver CLAUDE.md § R-044."
      blocked=1
    fi
  done <<< "$staged_gov_files"
fi

# 5) Bloqueio de nomes de projetos locais EXTERNOS em arquivos staged (R-044).
#    Projetos cujo path_externo resolve DENTRO da própria raiz deste repositório
#    (ex.: sub-projetos do monorepo como apps/web ou deploy/local-chat-gateway)
#    NÃO são "evidência de análise de repositório externo" — são o próprio
#    código sendo versionado aqui, e seus nomes de pacote aparecem legitimamente
#    em package.json/pyproject.toml/Dockerfiles/docs. Apenas ids cujo
#    path_externo aponta para FORA da raiz deste repo são tratados como vazamento
#    real de nome de projeto local privado (R-043/R-044).
target_catalog=""
if [ -f ".github/projects.local.yaml" ]; then
  target_catalog=".github/projects.local.yaml"
elif [ -f "docs/ai-context/catalog.local.yaml" ]; then
  target_catalog="docs/ai-context/catalog.local.yaml"
fi

if [ -n "$target_catalog" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  repo_root_norm=$(printf '%s' "$repo_root" | tr '[:upper:]' '[:lower:]' | sed -E 's#\\\\|\\#/#g' | sed -E 's#^([a-z]):/#/\1/#')

  all_ids=$(grep -E '^\s*-\s*id:' "$target_catalog" | awk -F'"' '{print $2}')
  all_paths=$(grep -E '^\s*path_externo:' "$target_catalog" | awk -F'"' '{print $2}')

  idx=0
  while IFS= read -r proj_id; do
    idx=$((idx + 1))
    [ -z "$proj_id" ] && continue
    [ "$proj_id" = "deep-agents-copilot" ] && continue

    proj_path=$(printf '%s\n' "$all_paths" | sed -n "${idx}p")
    proj_path_norm=$(printf '%s' "$proj_path" | tr '[:upper:]' '[:lower:]' | sed -E 's#\\\\|\\#/#g' | sed -E 's#^([a-z]):/#/\1/#')

    # Sub-projeto do próprio monorepo (path_externo dentro da raiz do repo atual) — não bloquear.
    case "$proj_path_norm" in
      "$repo_root_norm"/*|"$repo_root_norm") continue ;;
    esac

    if git diff --cached | grep -iE "^\+.*$proj_id" >/dev/null 2>&1; then
      echo "❌ [R-044] Bloqueado: diff staged contém referência nominal ao projeto local '$proj_id'."
      echo "   → Genericize para [PROJETO-ALVO] ou [PROJETO-EXEMPLO]. Ver CLAUDE.md § R-044."
      blocked=1
    fi
  done <<< "$all_ids"
fi

# 6) Defesa Anti-Truncamento de Histórico para CHANGELOG.md:
#    O CHANGELOG.md é estritamente aditivo. Comparamos o MULTISET de cabeçalhos
#    de versão (## [X.Y.Z] — AAAA-MM-DD) entre HEAD e o conteúdo staged (índice).
#    Bloqueia apenas se um cabeçalho de HEAD estiver genuinamente AUSENTE no
#    staged — reordenação por inserção de novas entradas antes de um cabeçalho
#    existente (artefato textual do diff Myers) NÃO é tratada como remoção.
#
#    Limitação conhecida (comportamento seguro por padrão):
#    O comando 'comm -23' opera sobre fluxos ordenados linha a linha e é
#    sensível à multiplicidade de ocorrências. Se HEAD contiver um cabeçalho
#    duplicado (ex.: erro histórico anterior) e um commit staged remover uma das
#    duplicatas mantendo a outra, 'comm -23' detectará a linha excedente como
#    ausente no staged e bloqueará o commit. Esse falso positivo em correções
#    legítimas de duplicatas é uma limitação conhecida e aceita: o guard prioriza
#    sempre a segurança estrita contra perda de histórico (safe by default).
if git -c core.quotepath=off diff --cached --name-only | grep -E '^CHANGELOG\.md$' >/dev/null 2>&1; then
  headers_head=$(git show HEAD:CHANGELOG.md 2>/dev/null | grep -E '^##\s+\[' | sort || true)
  headers_staged=$(git show :CHANGELOG.md 2>/dev/null | grep -E '^##\s+\[' | sort || true)
  if [ -n "$headers_head" ]; then
    missing_headers=$(comm -23 <(echo "$headers_head") <(echo "$headers_staged") 2>/dev/null || true)
    if [ -n "$missing_headers" ]; then
      echo "❌ [Anti-Truncamento] Bloqueado: remoção líquida de cabeçalho(s) de versão histórica em CHANGELOG.md detectada:"
      echo "$missing_headers"
      echo "   → O CHANGELOG.md deve ser estritamente aditivo. Reversões de versões históricas são proibidas."
      blocked=1
    fi
  fi
fi

# 7) Defesa contra vazamento de variantes de perfil de modelo (T-B3.4 / D4'):
#    Bloqueia commits contendo variantes locais de model-profiles staged em .github/agents/
#    ou .github/prompts/, garantindo que variantes nunca vazem para o repositório compartilhado.
has_staged_agent_prompts=0
first_agent_prompt=""
if IFS= read -r -d '' first_agent_prompt < <(git -c core.quotepath=off diff --cached -z --name-only -- .github/agents .github/prompts 2>/dev/null); then
  has_staged_agent_prompts=1
elif [ -n "$first_agent_prompt" ]; then
  has_staged_agent_prompts=1
fi

if [ "$has_staged_agent_prompts" -eq 1 ]; then
  state_file=".model-profiles/state.json"
  has_active_state=0
  if [ -f "$state_file" ]; then
    if grep -E '"phase"\s*:\s*"(applied|pending)"' "$state_file" >/dev/null 2>&1; then
      has_active_state=1
    fi
  fi

  staged_has_model_change=0
  if git diff --cached -- .github/agents .github/prompts 2>/dev/null | grep -E '^\+[ ]*model:' >/dev/null 2>&1; then
    staged_has_model_change=1
  fi

  has_profiles_manifest_staged=0
  if git -c core.quotepath=off diff --cached --name-only | grep -E '^model-profiles\.yaml$' >/dev/null 2>&1; then
    has_profiles_manifest_staged=1
  fi

  if [ "$has_active_state" -eq 1 ] && [ "$staged_has_model_change" -eq 1 ]; then
    echo "❌ [T-B3.4] Bloqueado: perfil de modelo ativo detectado (.model-profiles/state.json) com alterações staged em 'model:'."
    echo "   → Restaure o perfil default antes de commitar:"
    echo "     python -m tools.model_profiles restore"
    echo "   → Escape controlado (mudança canônica intencional): inclua model-profiles.yaml no mesmo commit."
    echo "   → Ver: docs/guides/model-profiles.md"
    blocked=1
  elif [ "$staged_has_model_change" -eq 1 ] && [ "$has_profiles_manifest_staged" -eq 0 ]; then
    echo "❌ [T-B3.4] Bloqueado: alteração na linha 'model:' em agents/prompts sem atualização correspondente em model-profiles.yaml."
    echo "   → Se você aplicou um perfil local, restaure o default antes de commitar:"
    echo "     python -m tools.model_profiles restore"
    echo "   → Se a mudança for canônica/definitiva, inclua model-profiles.yaml no mesmo commit."
    echo "   → Escape emergencial: git commit --no-verify"
    echo "   → Ver: docs/guides/model-profiles.md"
    blocked=1
  fi
fi

if [ "$blocked" -ne 0 ]; then
  echo ""
  echo "Commit abortado — violação de R-043/R-044. Ver CLAUDE.md § R-043 / § R-044."
  exit 1
fi

exit 0
