{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "security-reviewer",
  "name": "Security Reviewer",
  "version": "1.0.0",
  "description": "Revisa código de aplicação por segurança especializada (OWASP Top 10:2025, ASVS 5.0, CVE em dependências, secrets expostos). Nunca corrige, apenas analisa e reporta; complementa code-review (dimensão genérica) com profundidade de security specialist. Read-only.",
  "domain": "Revisao especializada de seguranca de aplicacao (read-only)",
  "role": "specialist",
  "capabilities": [
    "revisao de seguranca",
    "security review",
    "owasp",
    "cve",
    "vulnerabilidade",
    "secrets no codigo",
    "sast",
    "sca"
  ],
  "skills": [
    "security-review-patterns",
    "code-review-patterns",
    "agent-contracts",
    "handoff-governance",
    "confidence-fallback-policy",
    "terminal-governance",
    "context-mode"
  ],
  "tools": [
    "list_dir",
    "grep_search",
    "file_search",
    "run_in_terminal",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5.5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.55,
    "estimated_time_minutes": 25
  }
}
