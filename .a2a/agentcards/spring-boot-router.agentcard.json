{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "spring-boot-router",
  "name": "Spring Boot Router",
  "version": "2.0.0",
  "description": "Roteador de domínio Spring Boot e supervisor hierárquico — recebe solicitações de backend Java/Spring Boot do agent-router central e despacha para os 7 especialistas do catálogo Spring Boot (arch-advisor, feature-developer, bug-fixer, perf-tuner, unit-test-writer, integration-test-writer e test-fixer).",
  "domain": "Supervisor hierarquico e roteador do dominio Spring Boot",
  "role": "router",
  "capabilities": [
    "spring boot",
    "spring boot router",
    "backend router",
    "java lts",
    "jdk",
    "jpa",
    "hikaricp"
  ],
  "skills": [
    "agent-contracts",
    "handoff-governance",
    "context-mode"
  ],
  "tools": [
    "read_file",
    "file_search",
    "grep_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "context-mode/ctx_search"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only"
    ],
    "least_privilege_level": "standard",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
