{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "struts-test-fixer",
  "name": "Struts Test Fixer",
  "version": "1.0.0",
  "description": "Diagnostica e corrige falhas em testes de Struts legados: ActionForward inválido em assert, falhas de MockStrutsTestCase, classpath XML e regressões de build Ant/Maven.",
  "domain": "Diagnóstico e reparo de suítes de teste Struts quebradas em builds legados Ant/Maven Surefire",
  "role": "fixer",
  "capabilities": [
    "fix teste struts",
    "falha strutstestcase",
    "corrigir teste legado struts",
    "surefire struts error",
    "struts-config nao encontrado teste"
  ],
  "skills": [
    "agent-contracts",
    "handoff-governance"
  ],
  "tools": [
    "read_file",
    "file_search",
    "grep_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "insert_edit_into_file",
    "get_errors",
    "run_in_terminal",
    "context-mode/ctx_search",
    "context-mode/ctx_batch_execute"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "mutating",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Gemini 3.8 Flash",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/backend/struts/struts-catalog.yaml",
    "priority": 10,
    "estimated_time_minutes": 15
  }
