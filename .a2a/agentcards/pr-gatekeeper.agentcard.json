{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "pr-gatekeeper",
  "name": "Pr Gatekeeper",
  "version": "1.2.0",
  "description": "Prepara submissao de PR pos-aprovacao do quality gate — sintetiza diff, aplica guardrail de segredos e template semantico SSOT (/commit), gera titulo e descricao de PR com matriz de risco e atualiza CHANGELOG.md. Nunca executa git add/commit/push (R-031).",
  "domain": "Preparacao de entrega (PR/commit/changelog)",
  "role": "gatekeeper",
  "capabilities": [
    "pull request",
    "commit semantico",
    "changelog",
    "matriz de risco",
    "git hygiene"
  ],
  "skills": [
    "git-governance",
    "agent-contracts",
    "terminal-governance"
  ],
  "tools": [
    "grep_search",
    "file_search",
    "list_dir",
    "run_in_terminal",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute",
    "ask_questions",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Gemini 3.8 Flash",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.5,
    "estimated_time_minutes": 15
  }
}