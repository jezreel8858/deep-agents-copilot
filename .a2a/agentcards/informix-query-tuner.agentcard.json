    "otimizar query informix",
    "dirty read informix",
    "isolation informix",
    "diretiva informix",
    "update statistics"
  ],
  "skills": [
    "agent-contracts",
    "handoff-governance"
  ],
  "tools": [
    "read_file",
    "file_search",
    "grep_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_batch_execute"
  ],
