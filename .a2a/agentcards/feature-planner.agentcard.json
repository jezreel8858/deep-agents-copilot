{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "feature-planner",
  "name": "Feature Planner",
  "version": "2.0.0",
  "description": "Decompõe requisitos de feature nova (não refatoração) em subtasks executáveis com dependências mapeadas, paralelização e critério de pronto objetivo. Nunca implementa código; retorna plano estruturado para delegação a agents especializados. Distinto de refactor-planner (foco em risco/rollback de código existente).",
  "domain": "Decomposicao de feature nova em subtasks executaveis",
  "role": "planner",
  "capabilities": [
    "decompor tarefa",
    "planejar feature",
    "task decomposition",
    "plano de execucao",
    "quebrar em subtarefas"
  ],
  "skills": [
    "task-decomposition-patterns",
    "agent-contracts",
    "confidence-fallback-policy",
    "context-mode"
  ],
  "tools": [
    "grep_search",
    "file_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only"
    ],
    "least_privilege_level": "standard",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.1,
    "estimated_time_minutes": 20
  }
}