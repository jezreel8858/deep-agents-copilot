{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "requirements-analyst",
  "name": "Requirements Analyst",
  "version": "2.1.0",
  "description": "Especialista em elicitação, refinamento e estruturação de requisitos de negócio e técnicos a partir de pedidos ambíguos. Converte intenção em especificações precisas com critérios de aceitação e regras de negócio antes do planejamento técnico, materializando-as em docs/requirements/REQ-<modulo>.md como ground truth.",
  "domain": "Elicitacao e estruturacao de requisitos (prospectivo, pre-tecnico)",
  "role": "specialist",
  "capabilities": [
    "levantar requisitos",
    "requisito ambiguo",
    "elicitacao de requisitos",
    "user story",
    "criterio de aceite",
    "requisito funcional",
    "requisito nao funcional"
  ],
  "skills": [
    "requirements-engineering-patterns",
    "structured-intake-patterns",
    "documentation-writing-patterns",
    "agent-contracts",
    "context-mode",
    "efficient-batch-code-modification",
    "socratic-grilling-patterns"
  ],
  "tools": [
    "grep_search",
    "file_search",
    "list_dir",
    "get_errors",
    "ask_questions",
    "run_subagent",
    "context-mode/ctx_execute",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index",
    "context-mode/ctx_search",
    "context-mode/ctx_batch_execute"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only"
    ],
    "least_privilege_level": "standard",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.8,
    "estimated_time_minutes": 25
  }
}