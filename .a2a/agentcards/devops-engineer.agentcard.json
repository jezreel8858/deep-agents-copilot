{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "devops-engineer",
  "name": "Devops Engineer",
  "version": "1.0.0",
  "description": "Revisa artefatos DevOps — Dockerfile, Kubernetes, CI/CD pipelines, Infrastructure-as-Code — por segurança, resiliência e boas práticas. Nunca corrige, apenas analisa e reporta. Read-only.",
  "domain": "Revisao de artefatos DevOps (read-only)",
  "role": "specialist",
  "capabilities": [
    "revisar dockerfile",
    "revisar kubernetes",
    "revisar pipeline",
    "revisar ci/cd",
    "infrastructure as code",
    "terraform",
    "helm chart"
  ],
  "skills": [
    "devops-agent-patterns",
    "security-review-patterns",
    "agent-contracts",
    "context-mode"
  ],
  "tools": [
    "list_dir",
    "grep_search",
    "file_search",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only"
    ],
    "least_privilege_level": "standard",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 8.9,
    "estimated_time_minutes": 25
  }
}
