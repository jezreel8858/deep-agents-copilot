{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "angular-bug-fixer",
  "name": "Angular Bug Fixer",
  "version": "1.0.0",
  "description": "Especialista em resolução rápida de bugs: corrige runtime errors, ExpressionChanged..., memory leaks e falhas de reatividade com diff mínimo.",
  "domain": "Correções cirúrgicas de bugs e runtime errors em produção",
  "role": "fixer",
  "capabilities": [
    "bug angular",
    "fix angular",
    "runtime error angular",
    "expressionchanged",
    "memory leak angular",
    "corrigir erro angular"
  ],
  "skills": [
    "agent-contracts",
    "handoff-governance"
  ],
  "tools": [
    "read_file",
    "file_search",
    "grep_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "insert_edit_into_file",
    "get_errors",
    "run_in_terminal",
    "context-mode/ctx_search",
    "context-mode/ctx_batch_execute"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "mutating",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Gemini 3.8 Flash",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
