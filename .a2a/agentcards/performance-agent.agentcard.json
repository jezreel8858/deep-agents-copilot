{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "performance-agent",
  "name": "Performance Agent",
  "version": "1.0.0",
  "description": "Revisa código por performance especializada — Core Web Vitals (frontend), N+1 queries e profiling de latência (backend), otimização de query (banco). Nunca corrige, apenas analisa e reporta com evidência mensurável. Read-only.",
  "domain": "Revisao especializada de performance (read-only)",
  "role": "specialist",
  "capabilities": [
    "performance",
    "otimizacao",
    "latencia",
    "n+1",
    "core web vitals",
    "query lenta",
    "throughput"
  ],
  "skills": [
    "performance-engineering-patterns",
    "code-review-patterns",
    "agent-contracts",
    "confidence-fallback-policy",
    "terminal-governance",
    "context-mode"
  ],
  "tools": [
    "list_dir",
    "grep_search",
    "file_search",
    "run_in_terminal",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5.5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.6,
    "estimated_time_minutes": 25
  }
}
