  "domain": "Planejamento e decomposição macro de refatoração",
  "role": "planner",
  "capabilities": [
    "refactor",
    "planejamento",
    "rollback",
    "riscos",
    "decomposição",
    "mikado",
    "strangler fig"
  ],
  "skills": [
    "refactoring-planning-patterns",
    "context-mode",
    "agent-contracts",
    "confidence-fallback-policy",
    "code-tracing",
    "business-rules-governance",
    "integration-contract-analysis"
  ],
  "tools": [
    "read_file",
    "grep_search",
    "file_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "context-mode/ctx_execute",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index",
    "context-mode/ctx_search",
    "context-mode/ctx_fetch_and_index",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_stats",
    "context-mode/ctx_doctor",
    "context-mode/ctx_upgrade",
    "context-mode/ctx_purge",
    "context-mode/ctx_insight"
