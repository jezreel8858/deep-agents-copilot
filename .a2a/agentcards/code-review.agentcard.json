{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "code-review",
  "name": "Code Review",
  "version": "1.0.0",
  "description": "Revisa código (diff/PR) antes do merge por qualidade, segurança, convenções, impacto, testes e performance. Classifica achados por severidade, nunca corrige o código e delega para agents especializados quando necessário.",
  "domain": "Revisao de codigo antes do merge (read-only, severidade)",
  "role": "specialist",
  "capabilities": [
    "revisar codigo",
    "code review",
    "revisao antes do merge",
    "analisar pull request",
    "revisar diff",
    "revisar pr"
  ],
  "skills": [
    "code-review-patterns",
    "code-tracing",
    "agent-contracts",
    "terminal-governance",
    "context-mode"
  ],
  "tools": [
    "list_dir",
    "grep_search",
    "file_search",
    "run_in_terminal",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.5,
    "estimated_time_minutes": 20
  }
}