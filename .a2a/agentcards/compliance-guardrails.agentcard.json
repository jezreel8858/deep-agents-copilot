{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "compliance-guardrails",
  "name": "Compliance Guardrails",
  "version": "1.0.0",
  "description": "Avalia conformidade regulatória de código de aplicação (SOC 2, GDPR/LGPD, HIPAA, ISO 27001) — audit trails, least privilege, retenção de dados pessoais. Distinto de agent-safety-guardrails (segurança do próprio agent de IA). Nunca corrige, apenas analisa e reporta. Read-only.",
  "domain": "Avaliacao de conformidade regulatoria de aplicacao (read-only)",
  "role": "specialist",
  "capabilities": [
    "compliance",
    "auditoria",
    "soc 2",
    "gdpr",
    "lgpd",
    "hipaa",
    "audit trail",
    "least privilege"
  ],
  "skills": [
    "compliance-governance-patterns",
    "security-review-patterns",
    "agent-contracts",
    "confidence-fallback-policy",
    "context-mode"
  ],
  "tools": [
    "list_dir",
    "grep_search",
    "file_search",
    "run_subagent",
    "context-mode/ctx_search",
    "context-mode/ctx_execute",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only"
    ],
    "least_privilege_level": "standard",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Claude Sonnet 5.5",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
  },
  "output_contract": {
    "expected_format": "markdown estruturado com Agente Ativo e Handoff",
    "emits_handoff": true,
    "context_offloading_supported": true
  },
  "metadata": {
    "catalog_source": ".github/agents/catalog.yaml",
    "priority": 4.65,
    "estimated_time_minutes": 30
  }
