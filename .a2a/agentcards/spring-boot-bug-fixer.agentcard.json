{
  "schemaVersion": "1.0.0",
  "protocol": "A2A/1.0.0",
  "id": "spring-boot-bug-fixer",
  "name": "Spring Boot Bug Fixer",
  "version": "1.0.0",
  "description": "Especialista em resolução rápida de bugs: corrige BusinessException, LazyInitializationException, rollbacks incorretos e deadlocks com diff mínimo e teste de regressão.",
  "domain": "Correções cirúrgicas de exceptions de runtime, transações e bugs em produção",
  "role": "fixer",
  "capabilities": [
    "bug spring boot",
    "fix spring",
    "lazyinitializationexception",
    "transactional rollback",
    "exceptionhandler",
    "corrigir erro spring"
  ],
  "skills": [
    "agent-contracts",
    "handoff-governance"
  ],
  "tools": [
    "file_search",
    "grep_search",
    "list_dir",
    "ask_questions",
    "run_subagent",
    "get_errors",
    "run_in_terminal",
    "context-mode/ctx_execute",
    "context-mode/ctx_search",
    "context-mode/ctx_batch_execute",
    "context-mode/ctx_execute_file",
    "context-mode/ctx_index"
  ],
  "security_profile": {
    "tool_zones": [
      "read-only",
      "mutating",
      "execution"
    ],
    "least_privilege_level": "elevated",
    "data_sensitivity": "internal"
  },
  "model_preferences": {
    "recommended_model": "Gemini 3.8 Flash",
    "cost_tier": "1x"
  },
  "input_contract": {
    "accepts_payload": "yaml / markdown",
    "required_fields": [
      "emissor",
      "contexto",
      "motivo"
    ]
