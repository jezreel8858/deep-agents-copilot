# Variáveis de ambiente para Observabilidade (OTel Collector Proxy + Langfuse Cloud)
# Obtenha suas chaves em: https://cloud.langfuse.com (ou https://us.cloud.langfuse.com) -> Settings -> API Keys

# Host da API Langfuse Cloud (EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com)
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Credenciais do Projeto Langfuse Cloud
LANGFUSE_PUBLIC_KEY=pk-lf-seu-public-key-aqui
LANGFUSE_SECRET_KEY=sk-lf-seu-secret-key-aqui

# Header OTLP HTTP Basic Auth: base64(LANGFUSE_PUBLIC_KEY:LANGFUSE_SECRET_KEY)
# Exemplo de geração:
#   Linux/macOS: echo -n "pk-lf-xxx:sk-lf-yyy" | base64
#   PowerShell:  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("pk-lf-xxx:sk-lf-yyy"))
LANGFUSE_OTLP_AUTH=cGstbGYtc2V1LXB1YmxpYy1rZXk6c2stbGYtc2V1LXNlY3JldC1rZXk=

# Ambiente e Identificação
DEPLOY_ENV=development
