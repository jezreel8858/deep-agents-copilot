# Variáveis de ambiente para o stack de Observabilidade (OTel Collector + Langfuse)

# Banco de Dados PostgreSQL
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse

# Segredos de Criptografia do Langfuse (necessários em produção/dev)
NEXTAUTH_SECRET=my-very-secure-nextauth-secret-for-local-dev-12345
SALT=my-very-secure-salt-for-local-dev-12345
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXTAUTH_URL=http://localhost:3000

# Headless Initialization (Cria usuário e projeto automaticamente)
LANGFUSE_INIT_ORG_ID=deep-agents-org
LANGFUSE_INIT_ORG_NAME=Deep Agents Org
LANGFUSE_INIT_PROJECT_ID=deep-agents-copilot
LANGFUSE_INIT_PROJECT_NAME=deep-agents-copilot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-deep-agents-local-001
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-deep-agents-local-001
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=adminpassword123
